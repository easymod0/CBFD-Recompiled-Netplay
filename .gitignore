# N64Recomp output and intermediates (recomp/recompile.py; recomp/run.sh for the ELF)
/RecompiledFuncs/
/recomp/build/
/recomp/conker.us.recomp.elf
/recomp/n64recomp.out
/recomp/n64recomp.err
/conker.elf.toml
/dump.toml
/data_dump.toml
/host/build/
/conker_data/
/host/build-win/
/host/build-linux/
/host/build-win-log.txt
__pycache__/
/tools/BanjoRecomp/
/tools/BKRecompModTemplate/
# Mod build output (mods/syms/ is committed; recomp/run.sh regenerates it)
/mods/*/build/
/mods/dist/
# Nothing from the game itself: ROMs, saves, and anything extracted from them
*.z64
*.n64
*.v64
*.bin
*.eep
/host/user_save.bin
/.claude/
/.venv/
/tools/macos/
# The fork's release workflow (.github/workflows/netplay-release.yml): its caches, the ROM's clone, the
# checks' logs and the packages. Untracked files make the netplay build id "dirty" (build_id.cmake), and
# a cache differs on each platform: a Windows and a Linux release wouldn't play together.
/.ccache/
/ccache-bin/
/vcpkg-cache/
/rom-src/
/package/
/netplay-check/
/netplay-rollback/
/netplay-rollback-modes/
/netplay-spectators/
/notes.md
