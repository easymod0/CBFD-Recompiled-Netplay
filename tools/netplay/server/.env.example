# The server's name, which players connect to: its IPv4 address is looked up as the servers start. With
# Cloudflare, its record must be "DNS only" (grey cloud): the proxy carries no UDP.
PUBLIC_HOST=
# Or its public IPv4 address, which is used instead if set.
#PUBLIC_IP=
# The secret the signalling server and coturn share, to make each player's TURN credentials: 16 characters
# or more, random (e.g. openssl rand -hex 24: letters and digits only). Players never see it.
TURN_SECRET=
# Optional.
#IMAGE=ghcr.io/easymod0/conker-netplay-server:latest
#SIGNAL_PORT=27100
#MAX_PER_ADDRESS=8
#TURN_HOURS=12
#TURN_TOTAL_QUOTA=400
