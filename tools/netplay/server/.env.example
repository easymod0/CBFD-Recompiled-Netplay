# The server's public IPv4 address (what players connect to).
PUBLIC_IP=
# The secret the signalling server and coturn share, to make each player's TURN credentials: 16 characters
# or more, random (e.g. openssl rand -hex 24). Players never see it.
TURN_SECRET=
# Optional.
#IMAGE=ghcr.io/easymod0/conker-netplay-server:latest
#SIGNAL_PORT=27100
#MAX_PER_ADDRESS=8
#TURN_HOURS=12
#TURN_TOTAL_QUOTA=400
