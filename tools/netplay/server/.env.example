# The server's public IPv4 address (what players connect to).
PUBLIC_IP=
# The TURN relay's password (the game needs it too, until the signalling server hands out its own).
TURN_USER=conker
TURN_PASSWORD=
# Optional.
#IMAGE=ghcr.io/easymod0/conker-netplay-server:latest
#SIGNAL_PORT=27100
#MAX_PER_ADDRESS=8
#TURN_TOTAL_QUOTA=400
